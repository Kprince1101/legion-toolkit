{
  "jsPlugins": [
    "eslint-plugin-legion"
  ],
  "rules": {
    "legion/no-narrative-comments": [
      "error",
      {}
    ],
    "legion/scoped-disables": [
      "error",
      {
        "locked": [
          "max-lines"
        ]
      }
    ],
    "legion/no-disables": "off",
    "legion/no-react-fc": "error",
    "legion/no-enum": "error",
    "legion/no-function-keyword": "error",
    "legion/no-client-globals-in-state-init": "off",
    "legion/no-use-client-in-page": "off",
    "legion/guarded-context-hook": "error",
    "legion/presentational-components": [
      "error",
      {
        "reactCompiler": false
      }
    ],
    "legion/no-literal-conditions-in-jsx": "error",
    "legion/no-admin-client-in-browser": [
      "error",
      {
        "browserPaths": [
          "/"
        ]
      }
    ],
    "legion/no-manual-memo": "off",
    "legion/button-has-type": "off",
    "legion/no-target-blank-without-rel": "off",
    "legion/anchor-is-not-a-button": "off",
    "legion/img-has-alt": "off",
    "legion/no-dangerous-html": "off",
    "legion/no-array-index-key": "warn",
    "legion/no-hardcoded-hex": "warn",
    "legion/no-rn-button": "warn",
    "legion/touchable-has-accessibility-label": "warn",
    "legion/controlled-text-input": "warn",
    "legion/no-web-dialogs": "warn",
    "no-ternary": "error",
    "no-unneeded-ternary": [
      "error",
      {
        "defaultAssignment": false
      }
    ],
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.tsx"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 180,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**"
      ],
      "rules": {
        "max-lines": "off",
        "legion/no-hardcoded-hex": "off"
      }
    },
    {
      "files": [
        "lib/supabase/**",
        "src/lib/supabase/**",
        "**/*.d.ts",
        "types/db.ts",
        "src/types/db.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
