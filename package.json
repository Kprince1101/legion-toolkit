{
  "name": "legion-toolkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/require-yarn.ts",
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "clean": "yarn workspaces foreach -A run clean",
    "typecheck": "tsc -p tsconfig.json && yarn workspaces foreach -A --topological-dev run typecheck",
    "lint": "yarn legion-audit directives --ignore fixtures && oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=2",
    "check:umbrella": "node scripts/check-umbrella.ts",
    "check:metadata": "node scripts/check-metadata.ts",
    "sync:oxlintrc": "node scripts/sync-oxlintrc.ts",
    "check:oxlintrc": "node scripts/sync-oxlintrc.ts --check",
    "audit:self": "yarn legion-audit --ignore fixtures --no-deps-audit --md AUDIT.md --json audit.json",
    "changeset": "changeset",
    "version": "changeset version",
    "validate": "yarn build && yarn typecheck && yarn check:oxlintrc && yarn lint && yarn format:check && yarn check:umbrella && yarn check:metadata && yarn test:ci",
    "generate:presets": "node scripts/generate-presets.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@swc/core": "^1.15.0",
    "@swc/jest": "0.2.39",
    "@types/eslint": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^22.19.0",
    "@typescript-eslint/parser": "8.69.0",
    "@typescript-eslint/types": "8.69.0",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "legion-audit": "workspace:*",
    "legion-init": "workspace:*",
    "legion-rules": "workspace:*",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
