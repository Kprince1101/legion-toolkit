{
  "name": "legion-toolkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.ts",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "pnpm legion-audit directives --ignore fixtures && oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=2",
    "check:umbrella": "node scripts/check-umbrella.ts",
    "check:metadata": "node scripts/check-metadata.ts",
    "sync:oxlintrc": "node scripts/sync-oxlintrc.ts",
    "check:oxlintrc": "node scripts/sync-oxlintrc.ts --check",
    "audit:self": "pnpm legion-audit --ignore fixtures --no-deps-audit --md AUDIT.md --json audit.json",
    "changeset": "changeset",
    "version": "changeset version",
    "validate": "pnpm build && pnpm typecheck && pnpm check:oxlintrc && pnpm lint && pnpm format:check && pnpm check:umbrella && pnpm check:metadata && pnpm test:ci",
    "generate:presets": "node scripts/generate-presets.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@swc/core": "^1.15.0",
    "@swc/jest": "0.2.39",
    "@types/eslint": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/types": "8.71.2",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "legion-prettier-config": "workspace:*",
    "legion-rules": "workspace:*",
    "legion-toolkit": "workspace:*",
    "legion-tsconfig": "workspace:*",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
